# NTNU Table Tennis - see README.md "Running on a Raspberry Pi"
# Install to /etc/systemd/system/table-tennis.service
#
# Change User= and the two paths if you cloned somewhere other than
# /home/pi/Table-Tennis, then:
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now table-tennis

[Unit]
Description=NTNU Table Tennis scoreboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/Table-Tennis
ExecStart=/usr/bin/python3 /home/pi/Table-Tennis/run.py --host 0.0.0.0 --port 8000

# come back up if it ever crashes, and on reboot
Restart=on-failure
RestartSec=5

# To serve on port 80 so the url needs no ":8000", change --port 8000 to
# --port 80 above and uncomment the next line (binding below 1024 needs it):
#AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
